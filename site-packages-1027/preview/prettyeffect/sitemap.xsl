<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:s="http://www.sitemaps.org/schemas/sitemap/0.9">
<xsl:output method="html" encoding="UTF-8"/>
<xsl:template match="/">
<html><head><title>Pretty Effect: page list</title>
<style>body{font-family:Georgia,serif;background:#FDF6F4;color:#2A1820;margin:40px}h1{color:#7A3A4C;font-weight:400}
table{border-collapse:collapse;background:#FFFDFC;border-radius:18px;overflow:hidden}th,td{padding:10px 16px;border-bottom:1px solid #F1D7D8;text-align:left}
th{background:#F7E7E6}a{color:#2F6469}</style></head>
<body><h1>Pretty Effect, every page</h1>
<table><tr><th>Address</th><th>Updated</th><th>Priority</th></tr>
<xsl:for-each select="s:urlset/s:url"><tr><td><a href="{s:loc}"><xsl:value-of select="s:loc"/></a></td><td><xsl:value-of select="s:lastmod"/></td><td><xsl:value-of select="s:priority"/></td></tr></xsl:for-each>
</table></body></html>
</xsl:template>
</xsl:stylesheet>
