<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:s="http://www.sitemaps.org/schemas/sitemap/0.9">
<xsl:output method="html" encoding="UTF-8"/>
<xsl:template match="/">
<html><head><title>Verity National — card index of pages</title>
<style>body{background:#F4F1E8;color:#1B2420;font:15px/1.6 Georgia,serif;margin:0;padding:40px 20px}
h1{color:#2F4A3F;margin:0 0 6px}p{color:#4C5650}table{border-collapse:collapse;width:100%;max-width:900px;background:#FFFDF7;border-top:4px solid #A2493A}
th,td{padding:10px 12px;border-bottom:1px solid #CFC7B1;text-align:left}th{color:#2F4A3F;font-size:12px;letter-spacing:.12em;text-transform:uppercase}a{color:#2F4A3F}</style></head>
<body><h1>Verity National</h1><p>Card index of every page on veritynational.com.</p>
<table><tr><th>Page</th><th>Last changed</th><th>Priority</th></tr>
<xsl:for-each select="s:urlset/s:url"><tr><td><a href="{s:loc}"><xsl:value-of select="s:loc"/></a></td><td><xsl:value-of select="s:lastmod"/></td><td><xsl:value-of select="s:priority"/></td></tr></xsl:for-each>
</table></body></html>
</xsl:template>
</xsl:stylesheet>
