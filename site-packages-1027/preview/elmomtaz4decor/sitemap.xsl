<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:s="http://www.sitemaps.org/schemas/sitemap/0.9">
<xsl:output method="html" encoding="UTF-8"/>
<xsl:template match="/">
<html><head><title>Sitemap — El Momtaz Decor</title>
<style>body{margin:0;background:#FAF5EC;color:#1A2226;font-family:Cairo,system-ui,sans-serif}
header{background:#163C48;color:#E3BC6E;padding:28px 24px;border-bottom:3px solid #C8922E}
h1{margin:0;font-family:"El Messiri",Georgia,serif;font-size:28px}
main{max-width:900px;margin:24px auto;padding:0 16px}
table{border-collapse:collapse;width:100%;background:#fff}
th,td{border:1px solid #D9C49A;padding:9px 12px;text-align:left}th{background:#F3EBDC;color:#163C48}
a{color:#1E4D5C}</style></head>
<body><header><h1>El Momtaz Decor — pages of the shop</h1></header><main><table>
<tr><th>Address</th><th>Last changed</th><th>Priority</th></tr>
<xsl:for-each select="s:urlset/s:url"><tr><td><a href="{s:loc}"><xsl:value-of select="s:loc"/></a></td>
<td><xsl:value-of select="s:lastmod"/></td><td><xsl:value-of select="s:priority"/></td></tr></xsl:for-each>
</table></main></body></html>
</xsl:template>
</xsl:stylesheet>
