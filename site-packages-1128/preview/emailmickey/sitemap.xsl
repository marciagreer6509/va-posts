<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:s="http://www.sitemaps.org/schemas/sitemap/0.9">
<xsl:output method="html" encoding="UTF-8" indent="yes"/>
<xsl:template match="/">
<html lang="en-US">
<head>
<title>Route sheet | Mickey's Mailboxes</title>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<style>
body{margin:0;background:#FAF5EC;color:#1F1612;font-family:Georgia,"Times New Roman",serif;line-height:1.5}
.mmSheetTop{background:#1F1612;color:#FAF5EC;padding:10px 24px;font-size:14px}
.mmSheetBody{max-width:880px;margin:0 auto;padding:36px 24px 64px}
h1{font-family:Impact,"Arial Black",sans-serif;font-weight:400;font-size:44px;line-height:1;margin:0 0 6px}
p{margin:0 0 26px;color:#5A4B40}
ol{list-style:none;margin:0;padding:0 0 0 30px;border-left:3px dashed #B23A2E}
li{position:relative;margin:0 0 14px;padding:12px 16px;background:#FFFCF5;border:2px solid #1F1612;border-radius:8px}
li:before{content:"";position:absolute;left:-41px;top:16px;width:14px;height:14px;border-radius:50%;background:#FFFCF5;border:4px solid #B23A2E}
a{color:#2D6A92;font-weight:bold;word-break:break-all}
span{display:block;font-size:13px;color:#5A4B40}
</style>
</head>
<body>
<div class="mmSheetTop">Grand Rapids, Michigan &#183; Original Delivery across the US</div>
<div class="mmSheetBody">
<h1>Mickey's Mailboxes: the route sheet</h1>
<p>Every page on emailmickey.com, one stop each. This file is the sitemap search engines read; the styling is for people who wander in.</p>
<ol>
<xsl:for-each select="s:urlset/s:url">
<li><a href="{s:loc}"><xsl:value-of select="s:loc"/></a><span>Last walked <xsl:value-of select="s:lastmod"/> &#183; checked <xsl:value-of select="s:changefreq"/></span></li>
</xsl:for-each>
</ol>
</div>
</body>
</html>
</xsl:template>
</xsl:stylesheet>
