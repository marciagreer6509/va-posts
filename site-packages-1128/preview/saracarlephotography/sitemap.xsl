<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:s="http://www.sitemaps.org/schemas/sitemap/0.9">
<xsl:output method="html" encoding="UTF-8" indent="yes"/>
<xsl:template match="/">
<html lang="en-GB">
<head>
<meta charset="utf-8"/>
<title>Sara Carle Photography — every page on the roll</title>
<meta name="robots" content="noindex"/>
<style>
body{margin:0;font:16px/1.5 Arial,Helvetica,sans-serif;background:#F2F4F3;color:#0D1B21}
header{background:#0E4D64;color:#F2F4F3;padding:28px 32px}
header p{margin:6px 0 0;color:#EEB8A9;font-size:13px;letter-spacing:.09em;text-transform:uppercase}
h1{margin:0;font-size:26px;letter-spacing:.01em}
main{padding:24px 32px 48px;max-width:900px}
ol{list-style:none;margin:0;padding:10px 12px;background:#0D1B21;border-radius:3px}
li{display:flex;gap:14px;align-items:baseline;padding:11px 12px;margin:6px 0;background:#F2F4F3;border-radius:3px}
li b{color:#A64932;min-width:2.2em}
a{color:#0E4D64;font-weight:bold}
small{margin-left:auto;color:#525C60}
</style>
</head>
<body>
<header><h1>Sara Carle Photography</h1><p>Sitemap · frames in running order</p></header>
<main>
<ol>
<xsl:for-each select="s:urlset/s:url">
<li><b><xsl:value-of select="position()"/></b><a href="{s:loc}"><xsl:value-of select="s:loc"/></a><small><xsl:value-of select="s:lastmod"/></small></li>
</xsl:for-each>
</ol>
</main>
</body>
</html>
</xsl:template>
</xsl:stylesheet>
