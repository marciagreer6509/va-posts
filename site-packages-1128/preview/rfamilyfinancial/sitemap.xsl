<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:s="http://www.sitemaps.org/schemas/sitemap/0.9">
<xsl:output method="html" encoding="UTF-8" indent="yes"/>
<xsl:template match="/">
<html lang="en-US">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="robots" content="noindex"/>
<title>R Family Keepsakes — list of pages</title>
<style>
body{margin:0;padding:2.5rem 1rem;background:#F7F1E6;color:#1C211D;font:16px/1.7 Georgia,"Times New Roman",serif}
.rf-map{max-width:44rem;margin:0 auto;background:#FFFDF7;border:.5rem solid #2F4A3A;border-radius:.4rem;padding:2rem 2.2rem;box-shadow:0 18px 30px -18px rgba(28,33,29,.6)}
h1{font-weight:400;font-size:1.9rem;margin:0 0 .2rem}
p{margin:0 0 1.2rem;color:#4F5A50}
ol{margin:0;padding:0;list-style:none;border-top:5px double #1C211D}
li{display:flex;justify-content:space-between;gap:1rem;padding:.6rem 0;border-bottom:1px dotted #9A917C}
a{color:#2F4A3A}
span{color:#9C4230;white-space:nowrap}
</style>
</head>
<body>
<div class="rf-map">
<h1>R Family Keepsakes</h1>
<p>The contents of this website, for search engines and the curious. <xsl:value-of select="count(s:urlset/s:url)"/> pages.</p>
<ol>
<xsl:for-each select="s:urlset/s:url">
<li><a href="{s:loc}"><xsl:value-of select="s:loc"/></a><span><xsl:value-of select="s:lastmod"/></span></li>
</xsl:for-each>
</ol>
</div>
</body>
</html>
</xsl:template>
</xsl:stylesheet>
