<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:s="http://www.sitemaps.org/schemas/sitemap/0.9">
<xsl:output method="html" encoding="UTF-8" indent="yes"/>
<xsl:template match="/">
<html lang="en-US">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Fallen Dragon Studios: every page on the shelf</title>
<style>
body{margin:0;background:#F5EEE4;color:#22130E;font:17px/1.6 Georgia,"Times New Roman",serif}
header{border-bottom:10px solid #7A2E1D;padding:28px 6vw 22px}
h1{margin:0;font-size:28px;letter-spacing:.04em;text-transform:uppercase;color:#7A2E1D}
header p{margin:6px 0 0;color:#5B4034;font-style:italic}
main{padding:26px 6vw 60px;max-width:900px}
table{width:100%;border-collapse:collapse;background:#FBF7F0;border:1px solid #D4C0A5}
th{text-align:left;background:#EBDCC6;padding:10px 14px;font-size:15px}
td{padding:10px 14px;border-top:1px solid #D4C0A5;font-size:16px}
a{color:#22130E;text-decoration-color:#2C8C86;text-decoration-thickness:2px;text-underline-offset:3px}
td.kn_when{white-space:nowrap;color:#5B4034}
</style>
</head>
<body>
<header><h1>Fallen Dragon Studios</h1><p>Every page on the shelf, as the sitemap lists them.</p></header>
<main>
<table>
<tr><th>Page</th><th>Last fired</th><th>Checked</th></tr>
<xsl:for-each select="s:urlset/s:url">
<tr>
<td><a href="{s:loc}"><xsl:value-of select="s:loc"/></a></td>
<td class="kn_when"><xsl:value-of select="s:lastmod"/></td>
<td class="kn_when"><xsl:value-of select="s:changefreq"/></td>
</tr>
</xsl:for-each>
</table>
</main>
</body>
</html>
</xsl:template>
</xsl:stylesheet>
