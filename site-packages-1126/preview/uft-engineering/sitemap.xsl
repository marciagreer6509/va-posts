<body><main><h1>UFT Engineering · sheet index</h1><p>Every page on uft-engineering.com, as listed for search engines.</p>
<table><tr><th>Sheet address</th><th>Last revised</th><th>Priority</th></tr>
<xsl:for-each select="s:urlset/s:url"><tr><td><a href="{s:loc}"><xsl:value-of select="s:loc"/></a></td><td><xsl:value-of select="s:lastmod"/></td><td><xsl:value-of select="s:priority"/></td></tr></xsl:for-each>
</table></main></body></html>
</xsl:template>
</xsl:stylesheet>
