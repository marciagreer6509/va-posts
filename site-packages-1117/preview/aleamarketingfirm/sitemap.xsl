<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:s="http://www.sitemaps.org/schemas/sitemap/0.9">
<xsl:output method="html" encoding="UTF-8"/>
<xsl:template match="/">
<html><head><title>Alea Marketing Firm page list</title>
<style>body{font-family:system-ui,sans-serif;background:#F5F7F2;color:#132620;margin:0;padding:2.5rem 1.25rem}
h1{font-size:1.9rem;margin:0 0 .3rem;text-transform:uppercase;letter-spacing:.04em;color:#1F5C4A}
p{color:#46594F}table{border-collapse:collapse;width:100%;max-width:900px;background:#fff;border:2px solid #132620}
th{background:#1F5C4A;color:#fff;text-align:left;padding:.6rem .8rem}td{padding:.55rem .8rem;border-top:1px solid #C9D6CD}
a{color:#1F5C4A}</style></head>
<body><h1>Alea Marketing Firm</h1><p>Every public page on aleamarketingfirm.com, for search engines and curious readers.</p>
<table><tr><th>Page</th><th>Updated</th><th>Rhythm</th></tr>
<xsl:for-each select="s:urlset/s:url"><tr><td><a href="{s:loc}"><xsl:value-of select="s:loc"/></a></td><td><xsl:value-of select="s:lastmod"/></td><td><xsl:value-of select="s:changefreq"/></td></tr></xsl:for-each>
</table></body></html>
</xsl:template>
</xsl:stylesheet>
