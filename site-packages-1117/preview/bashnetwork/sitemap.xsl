<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:s="http://www.sitemaps.org/schemas/sitemap/0.9">
<xsl:template match="/"><html><head><title>Bash Party Goods page list</title>
<style>body{font-family:sans-serif;background:#FFF8F0;color:#2A1420;padding:2rem}h1{color:#B4235A}
table{border-collapse:collapse;background:#fff;border:2px solid #2A1420}td,th{padding:.5rem 1rem;border-bottom:1px solid #eadbe0;text-align:left}th{background:#2A1420;color:#FFF8F0}a{color:#1F7A6E}</style></head>
<body><h1>Bash Party Goods &#8212; every page on the shelf</h1><table><tr><th>Address</th><th>Changed</th><th>Priority</th></tr>
<xsl:for-each select="s:urlset/s:url"><tr><td><a href="{s:loc}"><xsl:value-of select="s:loc"/></a></td><td><xsl:value-of select="s:lastmod"/></td><td><xsl:value-of select="s:priority"/></td></tr></xsl:for-each>
</table></body></html></xsl:template></xsl:stylesheet>
