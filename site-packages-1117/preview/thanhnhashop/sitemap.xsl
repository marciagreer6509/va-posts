<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:s="http://www.sitemaps.org/schemas/sitemap/0.9">
<xsl:output method="html" encoding="UTF-8"/>
<xsl:template match="/">
<html><head><title>Thanh Nhã Shop · page index</title>
<style>body{font-family:Georgia,serif;background:#1E1414;color:#efe4d2;margin:0;padding:48px 20px}
.k{max-width:860px;margin:auto;border:1px solid #C6A033;padding:32px}h1{color:#C6A033;font-weight:400}
table{width:100%;border-collapse:collapse}td,th{padding:10px;border-bottom:1px solid #3d2a2a;text-align:left}a{color:#C6A033}</style></head>
<body><div class="k"><h1>Thanh Nhã Shop — every page on the site</h1>
<table><tr><th>Address</th><th>Updated</th><th>Priority</th></tr>
<xsl:for-each select="s:urlset/s:url"><tr><td><a href="{s:loc}"><xsl:value-of select="s:loc"/></a></td><td><xsl:value-of select="s:lastmod"/></td><td><xsl:value-of select="s:priority"/></td></tr></xsl:for-each>
</table></div></body></html>
</xsl:template>
</xsl:stylesheet>
