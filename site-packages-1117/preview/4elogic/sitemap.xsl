<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:s="http://www.sitemaps.org/schemas/sitemap/0.9">
<xsl:template match="/"><html><head><title>4E Logic sitemap</title>
<style>body{font-family:sans-serif;background:#F6F2E9;color:#1A2218;margin:40px}h1{color:#3D5A3A}table{border-collapse:collapse}td,th{padding:8px 14px;border-bottom:1px solid #C9BFA8;text-align:left}th{background:#1A2218;color:#F6F2E9}a{color:#2C4229}</style></head>
<body><h1>4E Logic: pages on this site</h1><table><tr><th>Page</th><th>Last changed</th></tr>
<xsl:for-each select="s:urlset/s:url"><tr><td><a href="{s:loc}"><xsl:value-of select="s:loc"/></a></td><td><xsl:value-of select="s:lastmod"/></td></tr></xsl:for-each>
</table></body></html></xsl:template></xsl:stylesheet>
