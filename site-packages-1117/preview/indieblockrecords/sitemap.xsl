<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:s="http://www.sitemaps.org/schemas/sitemap/0.9">
<xsl:output method="html" encoding="UTF-8"/>
<xsl:template match="/">
<html><head><title>Indie Block Records sitemap</title>
<style>body{margin:0;font-family:system-ui,sans-serif;background:#F5F3EF;color:#121220}
.top{background:#1A1A2E;color:#F5F3EF;padding:28px 24px;border-bottom:4px solid #F25F5C}
.top h1{margin:0;font-size:24px;letter-spacing:.12em;text-transform:uppercase}
table{border-collapse:collapse;margin:24px;min-width:60%}td,th{padding:10px 14px;border-bottom:1px dashed #C9C5BA;text-align:left}
th{color:#56546C;font-size:13px;text-transform:uppercase;letter-spacing:.1em}a{color:#A9312E}</style></head>
<body><div class="top"><h1>Indie Block Records · page list</h1></div>
<table><tr><th>Page</th><th>Last changed</th><th>Priority</th></tr>
<xsl:for-each select="s:urlset/s:url"><tr><td><a href="{s:loc}"><xsl:value-of select="s:loc"/></a></td>
<td><xsl:value-of select="s:lastmod"/></td><td><xsl:value-of select="s:priority"/></td></tr></xsl:for-each>
</table></body></html></xsl:template></xsl:stylesheet>
