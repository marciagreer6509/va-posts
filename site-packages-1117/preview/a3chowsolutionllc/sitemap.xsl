<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:s="http://www.sitemaps.org/schemas/sitemap/0.9">
<xsl:output method="html" encoding="UTF-8"/>
<xsl:template match="/"><html><head><title>A3 Chow Solution LLC sitemap</title>
<style>body{font-family:Georgia,serif;background:#FFF9F2;color:#1F1A17;margin:0;padding:30px}h1{color:#29335C}
table{border-collapse:separate;border-spacing:0 6px;width:100%;max-width:900px}td{background:#fff;padding:10px 14px}td:first-child{border-radius:12px 0 0 12px;border-left:6px solid #E2583A}td:last-child{border-radius:0 12px 12px 0}a{color:#AE3A1F}</style></head>
<body><h1>A3 Chow Solution LLC: page list</h1><table><xsl:for-each select="s:urlset/s:url"><tr><td><a href="{s:loc}"><xsl:value-of select="s:loc"/></a></td><td><xsl:value-of select="s:lastmod"/></td></tr></xsl:for-each></table></body></html>
</xsl:template></xsl:stylesheet>
